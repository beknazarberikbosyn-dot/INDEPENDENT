 {
  "lang": "kk",
  "text": "Жақсы, қала — Алматы. Мекенжайлар мен бағыттарды жаңарттым."
 },
 {
  "lang": "kk",
  "text": "Жақсы, қала — Астана. Мекенжайлар мен бағыттарды жаңарттым."
